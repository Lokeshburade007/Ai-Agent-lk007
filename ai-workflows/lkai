#!/usr/bin/env bash
# lkai — Aider wrapper that auto-loads stack rules + specialized prompts.
#
# Installed at: $HOME/bin/lkai (this file is the source of truth in the repo).
# To deploy: cp ai-workflows/lkai ~/bin/lkai && chmod +x ~/bin/lkai
#
# Renamed from 'agent' because Cursor IDE's cursor-agent CLI uses that name
# (symlinked at ~/.local/bin/agent) and was shadowing this wrapper.
#
# The master system prompt is auto-loaded by ~/.aider.conf.yml,
# so it's not duplicated in --read here.

set -euo pipefail

AGENT_BASE="${AGENT_BASE:-$HOME/Documents/LK/Important/PersonalAIAgent}"

STACK=""
CONCERN=""
INCLUDE_DEBUG_PLAYBOOK=0
PHASE=""

usage() {
  cat <<EOF
Usage: lkai [--stack <name>] [--concern <name>] [--debug] [--phase <name>] [aider args...]

  --stack <name>      adds ai-memory/rules/<name>-rules.md
                      one of: node | react | flutter | swiftui | golang
  --concern <name>    adds ai-prompts/prompts/specialized/<name>.md
                      one of: debugging | architecture-review | code-optimization
                              security-review | api-design | database-schema
                              ui-generation
  --debug             also include ai-memory/memory/debugging/<stack>.md
                      (requires --stack)
  --phase <name>      adds ai-workflows/prompts/<name>-coding.md
                      one of: before | during | after

All remaining args are passed through to aider.

Examples:
  lkai --phase before --stack react --message "scaffold a settings page"
  lkai --stack react src/components/Login.tsx
  lkai --stack node --concern security-review src/auth/
  lkai --stack node --debug --concern debugging --message "investigate 502 on /api/orders"
  lkai --concern api-design --message "design /v1/orders endpoints"

Tips:
  * To CREATE a new file, pass its path as a positional argument so Aider
    creates it empty before applying SEARCH/REPLACE:
      lkai --stack react src/components/Login.tsx --message "create a login form..."
  * Without --message, aider runs interactively. The '>' you see is aider's
    prompt — type your request after it, do not type '>' yourself.

Override the base dir: AGENT_BASE=/some/path lkai ...
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --stack)    STACK="$2"; shift 2 ;;
    --concern)  CONCERN="$2"; shift 2 ;;
    --debug)    INCLUDE_DEBUG_PLAYBOOK=1; shift ;;
    --phase)    PHASE="$2"; shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    *)          break ;;
  esac
done

READS=()

if [[ -n "$STACK" ]]; then
  RULE="$AGENT_BASE/ai-memory/rules/${STACK}-rules.md"
  if [[ -f "$RULE" ]]; then
    READS+=(--read "$RULE")
  else
    echo "lkai: stack rule not found: $RULE" >&2
    echo "      known stacks: node | react | flutter | swiftui | golang" >&2
    exit 1
  fi
fi

if [[ -n "$CONCERN" ]]; then
  PROMPT="$AGENT_BASE/ai-prompts/prompts/specialized/${CONCERN}.md"
  if [[ -f "$PROMPT" ]]; then
    READS+=(--read "$PROMPT")
  else
    echo "lkai: concern not found: $PROMPT" >&2
    exit 1
  fi
fi

if [[ "$INCLUDE_DEBUG_PLAYBOOK" -eq 1 ]]; then
  if [[ -z "$STACK" ]]; then
    echo "lkai: --debug requires --stack" >&2
    exit 1
  fi
  PLAYBOOK="$AGENT_BASE/ai-memory/memory/debugging/${STACK}.md"
  if [[ -f "$PLAYBOOK" ]]; then
    READS+=(--read "$PLAYBOOK")
  else
    echo "lkai: no debugging playbook for stack '$STACK' — skipping" >&2
  fi
fi

if [[ -n "$PHASE" ]]; then
  WORKFLOW="$AGENT_BASE/ai-workflows/prompts/${PHASE}-coding.md"
  if [[ -f "$WORKFLOW" ]]; then
    READS+=(--read "$WORKFLOW")
  else
    echo "lkai: phase prompt not found: $WORKFLOW" >&2
    echo "      known phases: before | during | after" >&2
    exit 1
  fi
fi

exec aider "${READS[@]}" "$@"
